# === Server ===
# Required in all environments
# Local: mongodb://127.0.0.1:27017/quicklaunch
# Atlas: mongodb+srv://<dbUser>:<dbPassword>@<cluster>.mongodb.net/quicklaunch
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>.mongodb.net/quicklaunch
MONGODB_DB_NAME=quicklaunch
# How long to wait for a MongoDB server selection before failing (default 5000ms).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Authentication (next-auth v4 reads NEXTAUTH_SECRET; AUTH_SECRET is an alias)
# Required in production. Use a long random string, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
AUTH_SECRET=

# === Public (exposed to the browser) ===
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth Web Client ID (public, safe to expose). Required for
# "Sign in with Google" and One Tap in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === Paystack (server-side) ===
# Obtain from https://dashboard.paystack.com — use test keys while developing.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# The secret used to validate webhook signatures (HMAC SHA512).
PAYSTACK_WEBHOOK_SECRET=

# === Google API (Google Classroom) ===
# Server-to-server or OAuth credentials for the Classroom API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLASSROOM_OWNER_EMAIL=

# === Google Calendar (session scheduling after payment) ===
# Creates a Google Calendar event with a Google Meet link for paid consultations.
# Requires the same OAuth credentials above, with the Calendar API enabled.
GOOGLE_CALENDAR_OWNER_EMAIL=
# Display name shown as the organizer on the calendar invite.
GOOGLE_CALENDAR_ORGANIZER_NAME=Agile Minds Hub
# Owner business hours and timezone used to generate bookable slots.
GOOGLE_CALENDAR_TIME_ZONE=Africa/Lagos
GOOGLE_CALENDAR_WORK_START=09:00
GOOGLE_CALENDAR_WORK_END=17:00

# === Google SMTP (transactional email) ===
# Uses a dedicated Gmail mailbox. Prefer an app password with 2-Step Verification.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=
MAIL_FROM_NAME=Agile Minds Hub
MAIL_FROM_EMAIL=

# Shared secret that must be sent to /api/cron/reminders to trigger booking
# reminder emails (24h and 1h before the call). Protect this like a password.
REMINDER_CRON_SECRET=

# Comma-separated list of email addresses to treat as back-office admins.
# When a user registers or signs in with one of these emails, their role is
# set to "admin", granting access to /admin (back office).
ADMIN_EMAILS=

# === AI (optional, added when an AI feature slice is built) ===
AI_PROVIDER_API_KEY=
AI_MODEL=